<Window x:Class="AutomatiskSportTV.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MatchFlow TV"
        Icon="Assets/app.ico"
        Width="1360"
        Height="820"
        MinWidth="960"
        MinHeight="600"
        Background="#090D16"
        WindowStartupLocation="CenterScreen"
        Loaded="MainWindow_Loaded"
        Closing="MainWindow_Closing"
        LocationChanged="MainWindow_BoundsChanged"
        SizeChanged="MainWindow_BoundsChanged"
        StateChanged="MainWindow_StateChanged"
        PreviewKeyDown="MainWindow_PreviewKeyDown">

    <Grid ClipToBounds="True">
        <!-- Offscreen host for silent background WebView2 sports scanners -->
        <Grid x:Name="ScannerHostGrid"
              Width="1280"
              Height="720"
              HorizontalAlignment="Left"
              VerticalAlignment="Top"
              Margin="-4000,-4000,0,0"
              IsHitTestVisible="False" />

        <!-- Main Viewport Layout (Row 0 = Login Top Bar when active, Row 1 = Standby, Screensaver, or Player WebView2) -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Interactive Login Mode Top Bar (sits cleanly above WebView2 with zero airspace overlap) -->
            <Border x:Name="LoginTopBar"
                    Grid.Row="0"
                    Visibility="Collapsed"
                    Background="#0F172A"
                    BorderBrush="#22C55E"
                    BorderThickness="0,0,0,2"
                    Padding="24,12">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <Button Content="⟳ Skanna denna tjänst nu" Style="{StaticResource TvButtonStyle}" Margin="0,0,10,0" Click="LoginRescanService_Click" />
                        <Button Content="✓ Klar — Tillbaka till TV (Esc)" Style="{StaticResource TvAccentButtonStyle}" Click="ExitLoginMode_Click" />
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="LoginBannerTitle" Text="Logga in på Viaplay" Foreground="#F8FAFC" FontSize="18" FontWeight="Bold" />
                        <TextBlock Text="Logga in och välj eventuell profil som vanligt i fönstret nedan. Sessionen sparas automatiskt." Foreground="#94A3B8" FontSize="13" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- TV Viewport Area -->
            <Grid Grid.Row="1">
                <!-- Standby / No Active Match View -->
                <Grid x:Name="StandbyView" Background="#090D16">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="1100" Margin="48,44,48,44">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14" VerticalAlignment="Center">
                                <Image Source="Assets/logo.png" Width="44" Height="44" Margin="0,0,14,0" RenderOptions.BitmapScalingMode="HighQuality" />
                                <Border Background="#16A34A" CornerRadius="8" Padding="12,5" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="MATCHFLOW TV" Foreground="White" FontSize="13" FontWeight="Bold" />
                                </Border>
                                <TextBlock x:Name="StandbyScanStatusText" Text="Startar skanning..." Foreground="#38BDF8" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>

                            <TextBlock x:Name="StandbyHeadlineText"
                                       Text="Söker efter pågående sport på dina tjänster..."
                                       Foreground="#F8FAFC"
                                       FontSize="34"
                                       FontWeight="Bold"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="Appen väljer automatiskt den match som passar din rangordning bäst och startar i fullskärm."
                                       Foreground="#94A3B8"
                                       FontSize="16"
                                       Margin="0,8,0,24"
                                       TextWrapping="Wrap" />

                            <WrapPanel Margin="0,0,0,28">
                                <Button Content="📺 Sportguide (G)" Style="{StaticResource TvAccentButtonStyle}" Margin="0,0,12,10" Click="StandbyGuide_Click" />
                                <Button Content="⭐ Rangordning (R)" Style="{StaticResource TvButtonStyle}" Margin="0,0,12,10" Click="StandbyRanking_Click" />
                                <Button Content="🔑 Tjänster &amp; Inloggning (L)" Style="{StaticResource TvButtonStyle}" Margin="0,0,12,10" Click="StandbyServices_Click" />
                                <Button Content="⟳ Skanna alla nu" Style="{StaticResource TvButtonStyle}" Margin="0,0,12,10" Click="StandbyScanNow_Click" />
                                <Button x:Name="StandbyUpdateButton" Visibility="Collapsed" Content="⬆ Uppdatera MatchFlow TV" Style="{StaticResource TvAccentButtonStyle}" Margin="0,0,12,10" Click="StandbyInstallUpdate_Click" />
                                <Button Content="🌙 Skärmsläckare (Z)" Style="{StaticResource TvButtonStyle}" Margin="0,0,12,10" Click="StandbyScreensaver_Click" />
                                <Button Content="⛶ Fullskärm (F11)" Style="{StaticResource TvButtonStyle}" Margin="0,0,0,10" Click="StandbyFullscreen_Click" />
                            </WrapPanel>

                            <TextBlock Text="STREAMINGTJÄNSTER (KLICKA FÖR ATT LOGGA IN / ÖPPNA)" Foreground="#94A3B8" FontSize="13" FontWeight="Bold" Margin="0,0,0,12" />
                            <WrapPanel x:Name="StandbyServiceChips" Margin="0,0,0,28" />

                            <TextBlock x:Name="StandbyUpcomingHeader" Text="KOMMANDE SÄNDNINGAR" Foreground="#38BDF8" FontSize="13" FontWeight="Bold" Margin="0,0,0,12" Visibility="Collapsed" />
                            <StackPanel x:Name="StandbyUpcomingList" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- OLED-Safe Floating TV Screensaver (shown automatically when no sport is available) -->
                <Canvas x:Name="ScreensaverView"
                        Visibility="Collapsed"
                        Background="#000000"
                        Cursor="None"
                        MouseDown="ScreensaverView_MouseDown">
                    <Border x:Name="ScreensaverFloatingCard"
                            Width="540"
                            Padding="28"
                            CornerRadius="20"
                            Background="#000000">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="ScreensaverTranslate" X="120" Y="120" />
                        </Border.RenderTransform>
                        <StackPanel>
                            <TextBlock x:Name="ScreensaverClockText"
                                       Text="12:45"
                                       Foreground="#E2E8F0"
                                       FontSize="86"
                                       FontWeight="Light" />
                            <TextBlock x:Name="ScreensaverDateText"
                                       Text="tisdag 24 november"
                                       Foreground="#64748B"
                                       FontSize="20"
                                       Margin="2,0,0,18" />

                            <StackPanel x:Name="ScreensaverInfoGroup">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Ellipse Width="10" Height="10" Fill="#22C55E" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Väntar på nästa livesport — skannar automatiskt"
                                               Foreground="#94A3B8"
                                               FontSize="15"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                                <TextBlock x:Name="ScreensaverNextMatchText"
                                           Text="Inga planerade matcher inlästa ännu."
                                           Foreground="#38BDF8"
                                           FontSize="15"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,14" />
                                <TextBlock Text="Rör musen eller tryck valfri tangent för att väcka"
                                           Foreground="#334155"
                                           FontSize="13" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Canvas>

                <!-- Dedicated Active Fullscreen Player Host -->
                <Grid x:Name="PlayerHostGrid" Visibility="Collapsed" Background="Black" />
            </Grid>
        </Grid>
    </Grid>
</Window>
