<Window x:Class="AutomatiskSportTV.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MatchFlow TV"
        Icon="Assets/app.ico"
        Width="1360"
        Height="820"
        MinWidth="960"
        MinHeight="600"
        Background="#090D16"
        WindowStartupLocation="CenterScreen"
        Loaded="MainWindow_Loaded"
        Closing="MainWindow_Closing"
        LocationChanged="MainWindow_BoundsChanged"
        SizeChanged="MainWindow_BoundsChanged"
        StateChanged="MainWindow_StateChanged"
        PreviewKeyDown="MainWindow_PreviewKeyDown">

    <Grid ClipToBounds="True">
        <!-- Main Viewport Layout (Row 0 = Login / Visual Scanner Top Bar when active, Row 1 = Standby, Screensaver, Player, or Visual Scanner WebView2) -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Interactive Login Mode Top Bar (sits cleanly above WebView2 with zero airspace overlap) -->
            <Border x:Name="LoginTopBar"
                    Grid.Row="0"
                    Visibility="Collapsed"
                    Background="#0F172A"
                    BorderBrush="#22C55E"
                    BorderThickness="0,0,0,2"
                    Padding="24,12">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <Button Content="👁 Öppna i visuell skanner" Style="{StaticResource TvButtonStyle}" Margin="0,0,10,0" Click="LoginOpenVisualScanner_Click" />
                        <Button Content="⟳ Skanna denna tjänst nu" Style="{StaticResource TvButtonStyle}" Margin="0,0,10,0" Click="LoginRescanService_Click" />
                        <Button Content="✓ Klar — Tillbaka till TV (Esc)" Style="{StaticResource TvAccentButtonStyle}" Click="ExitLoginMode_Click" />
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="LoginBannerTitle" Text="Logga in på Viaplay" Foreground="#F8FAFC" FontSize="18" FontWeight="Bold" />
                        <TextBlock Text="Logga in och välj eventuell profil som vanligt i fönstret nedan. Sessionen sparas automatiskt." Foreground="#94A3B8" FontSize="13" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Visual Live Scanner Monitor Top Bar (sits cleanly above ScannerHostGrid with zero airspace overlap) -->
            <Border x:Name="ScannerMonitorBar"
                    Grid.Row="0"
                    Visibility="Collapsed"
                    Background="#0B1324"
                    BorderBrush="#38BDF8"
                    BorderThickness="0,0,0,2"
                    Padding="20,10">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                            <Button x:Name="ScannerOpenLoginButton" Content="🔑 Logga in på tjänsten" Style="{StaticResource TvButtonStyle}" Padding="12,7" FontSize="13" Margin="0,0,8,0" Click="ScannerOpenLogin_Click" />
                            <Button Content="⟳ Skanna alla visuellt" Style="{StaticResource TvAccentButtonStyle}" Padding="12,7" FontSize="13" Margin="0,0,8,0" Click="ScannerScanAll_Click" />
                            <Button Content="✕ Stäng skannervy (V / Esc)" Style="{StaticResource TvButtonStyle}" Padding="12,7" FontSize="13" Click="ExitVisualScanner_Click" />
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#0284C7" CornerRadius="6" Padding="8,3" Margin="0,0,10,0">
                                    <TextBlock Text="👁 LIVE-SKANNER" Foreground="White" FontSize="11" FontWeight="Bold" />
                                </Border>
                                <TextBlock x:Name="ScannerActiveServiceText" Text="Redo att skanna" Foreground="#F8FAFC" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                                <TextBlock x:Name="ScannerLiveStatusText" Text="" Foreground="#38BDF8" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock x:Name="ScannerLiveUrlText" Text="Klicka på en tjänst nedan för att se exakt vad skannern laddar — du kan även klicka direkt på sidan." Foreground="#94A3B8" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DockPanel>
                    <WrapPanel x:Name="ScannerServiceTabsPanel" />
                </StackPanel>
            </Border>

            <!-- TV Viewport Area -->
            <Grid Grid.Row="1" ClipToBounds="True">
                <!-- Background / Visual WebView2 Sports Scanner Host (offscreen by default, full-size interactive when Visual Scanner Mode is open) -->
                <Grid x:Name="ScannerHostGrid"
                      Width="1280"
                      Height="720"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Top"
                      Margin="-4000,-4000,0,0"
                      Background="Black"
                      IsHitTestVisible="False" />
                <!-- Standby / No Active Match View -->
                <Grid x:Name="StandbyView" Background="#090D16">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="1100" Margin="48,44,48,44">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14" VerticalAlignment="Center">
                                <Image Source="Assets/logo.png" Width="44" Height="44" Margin="0,0,14,0" RenderOptions.BitmapScalingMode="HighQuality" />
                                <Border Background="#16A34A" CornerRadius="8" Padding="12,5" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="MATCHFLOW TV" Foreground="White" FontSize="13" FontWeight="Bold" />
                                </Border>
                                <TextBlock x:Name="StandbyScanStatusText" Text="Startar skanning..." Foreground="#38BDF8" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>

                            <TextBlock x:Name="StandbyHeadlineText"
                                       Text="Söker efter pågående sport på dina tjänster..."
                                       Foreground="#F8FAFC"
                                       FontSize="34"
                                       FontWeight="Bold"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="Appen väljer automatiskt den match som passar din rangordning bäst och startar i fullskärm."
                                       Foreground="#94A3B8"
                                       FontSize="16"
                                       Margin="0,8,0,24"
                                       TextWrapping="Wrap" />

                            <WrapPanel Margin="0,0,0,28">
                                <Button Content="📺 Sportguide (G)" Style="{StaticResource TvAccentButtonStyle}" Margin="0,0,12,10" Click="StandbyGuide_Click" />
                                <Button Content="⭐ Rangordning (R)" Style="{StaticResource TvButtonStyle}" Margin="0,0,12,10" Click="StandbyRanking_Click" />
                                <Button Content="🔑 Tjänster &amp; Inloggning (L)" Style="{StaticResource TvButtonStyle}" Margin="0,0,12,10" Click="StandbyServices_Click" />
                                <Button Content="👁 Visa live-skanner (V)" Style="{StaticResource TvButtonStyle}" Margin="0,0,12,10" Click="StandbyVisualScanner_Click" />
                                <Button Content="⟳ Skanna alla nu" Style="{StaticResource TvButtonStyle}" Margin="0,0,12,10" Click="StandbyScanNow_Click" />
                                <Button x:Name="StandbyUpdateButton" Visibility="Collapsed" Content="⬆ Uppdatera MatchFlow TV" Style="{StaticResource TvAccentButtonStyle}" Margin="0,0,12,10" Click="StandbyInstallUpdate_Click" />
                                <Button Content="🌙 Skärmsläckare (Z)" Style="{StaticResource TvButtonStyle}" Margin="0,0,12,10" Click="StandbyScreensaver_Click" />
                                <Button Content="⛶ Fullskärm (F11)" Style="{StaticResource TvButtonStyle}" Margin="0,0,0,10" Click="StandbyFullscreen_Click" />
                            </WrapPanel>

                            <TextBlock Text="STREAMINGTJÄNSTER (KLICKA FÖR ATT LOGGA IN / ÖPPNA)" Foreground="#94A3B8" FontSize="13" FontWeight="Bold" Margin="0,0,0,12" />
                            <WrapPanel x:Name="StandbyServiceChips" Margin="0,0,0,28" />

                            <TextBlock x:Name="StandbyUpcomingHeader" Text="KOMMANDE SÄNDNINGAR" Foreground="#38BDF8" FontSize="13" FontWeight="Bold" Margin="0,0,0,12" Visibility="Collapsed" />
                            <StackPanel x:Name="StandbyUpcomingList" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- OLED-Safe Animated TV Sports Screensaver (shown automatically when no sport is available or via Z) -->
                <Canvas x:Name="ScreensaverView"
                        Visibility="Collapsed"
                        Background="#000000"
                        ClipToBounds="True"
                        Cursor="None"
                        MouseDown="ScreensaverView_MouseDown">
                    <!-- Dynamic 60 FPS background effects (bouncing sport logo + sparks / arena floodlights / starfield) -->
                    <Canvas x:Name="ScreensaverEffectsCanvas"
                            Width="{Binding ActualWidth, ElementName=ScreensaverView}"
                            Height="{Binding ActualHeight, ElementName=ScreensaverView}"
                            IsHitTestVisible="False" />

                    <!-- Gently Drifting OLED-Safe Sports Lounge HUD Card -->
                    <Border x:Name="ScreensaverFloatingCard"
                            Width="600"
                            Padding="28"
                            CornerRadius="22"
                            Background="#D9070C17"
                            BorderBrush="#1E293B"
                            BorderThickness="1.5">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="ScreensaverTranslate" X="120" Y="120" />
                        </Border.RenderTransform>
                        <StackPanel>
                            <!-- Style & Bounce Stats Header -->
                            <DockPanel x:Name="ScreensaverHeaderRow" Margin="0,0,0,8">
                                <Border x:Name="ScreensaverBounceBadge"
                                        DockPanel.Dock="Right"
                                        Visibility="Collapsed"
                                        Background="#111827"
                                        BorderBrush="#334155"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="10,4"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="ScreensaverBounceStatsText"
                                               Text="Studsar: 0"
                                               Foreground="#94A3B8"
                                               FontSize="12"
                                               FontWeight="SemiBold" />
                                </Border>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse x:Name="ScreensaverRadarDot" Width="10" Height="10" Fill="#22C55E" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,10,0">
                                        <TextBlock x:Name="ScreensaverStyleLabel" Text="⚽ SPORTSTUDS" Foreground="#38BDF8" FontSize="11" FontWeight="Bold" />
                                    </Border>
                                    <TextBlock x:Name="ScreensaverLiveStatusLabel" Text="Skannar automatiskt" Foreground="#64748B" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                            </DockPanel>

                            <!-- Big Digital Clock + Seconds -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                <TextBlock x:Name="ScreensaverClockText"
                                           Text="16:30"
                                           Foreground="#F1F5F9"
                                           FontSize="78"
                                           FontWeight="Light" />
                                <TextBlock x:Name="ScreensaverSecondsText"
                                           Text=":00"
                                           Foreground="#38BDF8"
                                           FontSize="28"
                                           FontWeight="Light"
                                           Margin="4,0,0,14"
                                           VerticalAlignment="Bottom" />
                            </StackPanel>

                            <TextBlock x:Name="ScreensaverDateText"
                                       Text="tisdag 24 november"
                                       Foreground="#94A3B8"
                                       FontSize="18"
                                       Margin="2,-4,0,16" />

                            <StackPanel x:Name="ScreensaverInfoGroup">
                                <!-- Live Countdown Card to Next Match -->
                                <Border x:Name="ScreensaverCountdownCard"
                                        Background="#111827"
                                        BorderBrush="#1E293B"
                                        BorderThickness="1"
                                        CornerRadius="14"
                                        Padding="16,12"
                                        Margin="0,0,0,12">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,4">
                                            <TextBlock x:Name="ScreensaverCountdownTimerText"
                                                       DockPanel.Dock="Right"
                                                       Text=""
                                                       Foreground="#22C55E"
                                                       FontSize="16"
                                                       FontWeight="Bold"
                                                       VerticalAlignment="Center" />
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border x:Name="ScreensaverServiceBadge"
                                                        Visibility="Collapsed"
                                                        Background="#F43F5E"
                                                        CornerRadius="5"
                                                        Padding="7,2"
                                                        Margin="0,0,8,0">
                                                    <TextBlock x:Name="ScreensaverServiceBadgeText"
                                                               Text="VIAPLAY"
                                                               Foreground="White"
                                                               FontSize="11"
                                                               FontWeight="Bold" />
                                                </Border>
                                                <TextBlock x:Name="ScreensaverNextLabel"
                                                           Text="NÄSTA MATCH"
                                                           Foreground="#38BDF8"
                                                           FontSize="11"
                                                           FontWeight="Bold"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DockPanel>
                                        <TextBlock x:Name="ScreensaverNextMatchText"
                                                   Text="Inga planerade matcher inlästa ännu."
                                                   Foreground="#F8FAFC"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <!-- Rotating Upcoming Schedule / Sports Lounge Ticker -->
                                <TextBlock x:Name="ScreensaverTickerText"
                                           Text=""
                                           Foreground="#94A3B8"
                                           FontSize="13"
                                           TextWrapping="Wrap"
                                           Margin="2,0,0,12" />

                                <TextBlock Text="← / → Byt stil  •  Rör musen eller tryck valfri tangent för att väcka"
                                           Foreground="#475569"
                                           FontSize="12" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Canvas>

                <!-- Dedicated Active Fullscreen Player Host -->
                <Grid x:Name="PlayerHostGrid" Visibility="Collapsed" Background="Black" />
            </Grid>
        </Grid>
    </Grid>
</Window>
